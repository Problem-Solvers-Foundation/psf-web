  <script>
    window.addEventListener('load', () => {
      setTimeout(() => {
        document.querySelectorAll('.bar-fill[data-w]').forEach(bar => {
          bar.style.width = bar.dataset.w;
        });
      }, 400);
    });

    function toggleCluster(header) {
      const body = header.nextElementSibling;
      const arrow = header.querySelector('svg');
      body.classList.toggle('hidden');
      arrow.style.transform = body.classList.contains('hidden') ? '' : 'rotate(180deg)';
    }

    function filterCards() {
      const domain  = document.getElementById('f-domain').value;
      const urgency = document.getElementById('f-urgency').value;
      const source  = document.getElementById('f-source').value;
      document.querySelectorAll('#problems-grid > div').forEach(card => {
        const match = (domain  === 'All' || card.dataset.domain  === domain) &&
                      (urgency === 'All' || card.dataset.urgency === urgency) &&
                      (source  === 'All' || card.dataset.source  === source);
        card.style.display = match ? '' : 'none';
      });
    }

    function simulateRun() {
      const btn = document.getElementById('btn-run');
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg> Running...';

      // Reset funnel cards
      const nums = [['p-n0','—'],['p-n1','—'],['p-n2','—'],['p-n3','—'],['p-n4','—']];
      nums.forEach(([id]) => { const el = document.getElementById(id); if(el) { el.textContent = '…'; } });
      document.querySelectorAll('.stage-funnel > div').forEach(card => {
        card.classList.remove('border-primary','bg-blue-50','border-emerald-500','bg-emerald-50');
        card.classList.add('border-gray-200','bg-gray-50');
      });

      const log = document.getElementById('log-body');
      const ts = () => new Date().toLocaleTimeString('en-US', {hour12:false});
      const addLog = (level, msg, delay) => setTimeout(() => {
        const d = document.createElement('div'); d.className = 'log-line';
        d.innerHTML = `<span class="log-ts">${ts()}</span><span class="log-lvl ${level}">${level.padEnd(7)}</span><span class="log-msg">${msg}</span>`;
        log.appendChild(d); log.scrollTop = log.scrollHeight;
      }, delay);

      const activate = (stageId, n, label, delay) => setTimeout(() => {
        const card = document.querySelector(`#${stageId} > div`);
        if (card) { card.classList.remove('border-gray-200','bg-gray-50'); card.classList.add('border-primary','bg-blue-50'); }
        const numEl = document.getElementById('p-n'+stageId.slice(-1));
        if (numEl) { numEl.textContent = n; numEl.nextElementSibling.textContent = label; }
      }, delay);

      const done = (stageId, delay) => setTimeout(() => {
        const card = document.querySelector(`#${stageId} > div`);
        if (card) { card.classList.remove('border-primary','bg-blue-50'); card.classList.add('border-emerald-500','bg-emerald-50'); }
      }, delay);

      let t = 0;
      addLog('info',    'Pipeline started...', t += 200);
      activate('stage-0', '…', 'signals', t);
      addLog('success', '<em>138 signals</em> collected from all sources', t += 1400);
      activate('stage-0', '138', 'signals', t); done('stage-0', t += 100);
      addLog('info',    'Removing duplicates...', t += 300);
      activate('stage-1', '…', 'unique', t);
      addLog('success', '<em>91 duplicates</em> removed → <em>47 unique items</em>', t += 900);
      activate('stage-1', '47', 'unique', t); done('stage-1', t += 100);
      addLog('info',    'Analyzing: domain, urgency, semantic clusters...', t += 300);
      activate('stage-2', '…', 'classified', t);
      addLog('info',    'Semantic clustering — <em>3 groups</em> detected', t += 1000);
      addLog('info',    'Causal chain — <em>water scarcity → 3 downstream effects</em>', t += 600);
      activate('stage-2', '38', 'classified', t); done('stage-2', t += 100);
      addLog('info',    'Scoring by impact...', t += 300);
      activate('stage-3', '…', 'ranked', t);
      addLog('success', '<em>38 problems</em> ranked by impact score', t += 800);
      activate('stage-3', '38', 'ranked', t); done('stage-3', t += 100);
      addLog('info',    'Publishing to review queue...', t += 200);
      activate('stage-4', '…', 'pending', t);
      addLog('success', '<em>38 problems</em> published — awaiting admin review', t += 700);
      addLog('success', 'AI Digest generated — <em>3 clusters, 1 causal chain</em>', t += 300);
      activate('stage-4', '38', 'pending', t); done('stage-4', t += 100);
      addLog('success', 'Done — avg score: 0.68', t += 200);
      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Run Pipeline';
      }, t + 400);
    }
  </script>
