<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Aggregator - PSF</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { primary: "#117dd4" } } } };
  </script>
  <%- include('../partials/admin-styles') %>
  <style>
    @keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:.4} }
    .status-dot { width:8px;height:8px;border-radius:50%;background:#22c55e;animation:pulse-dot 2s ease-in-out infinite;box-shadow:0 0 6px #22c55e; }
    .alert-dot  { width:8px;height:8px;border-radius:50%;background:#ef4444;animation:pulse-dot 1s ease-in-out infinite;box-shadow:0 0 6px #ef4444; }
    .log-panel  { background:#111827;border-radius:10px;overflow:hidden;font-family:'Courier New',monospace; }
    .log-line   { display:flex;gap:12px;font-size:.72rem;line-height:1.8; }
    .log-ts  { color:#6b7280;flex-shrink:0; }
    .log-lvl { flex-shrink:0;width:56px;font-weight:700; }
    .log-lvl.info    { color:#60a5fa; }
    .log-lvl.success { color:#4ade80; }
    .log-lvl.warn    { color:#fbbf24; }
    .log-lvl.error   { color:#f87171; }
    .log-msg     { color:#9ca3af; }
    .log-msg em  { color:#e5e7eb;font-style:normal; }
    .score-badge { font-size:.7rem;font-weight:700;padding:2px 8px;border-radius:6px;font-family:'Courier New',monospace;flex-shrink:0; }
    .bar-fill    { height:8px;border-radius:4px;transition:width 1.2s ease-out; }
    .multi-source-badge { background:linear-gradient(135deg,#7c3aed,#2563eb);color:white;font-size:.65rem;font-weight:700;padding:2px 8px;border-radius:9999px;text-transform:uppercase;letter-spacing:.05em; }
    .causal-node { background:white;border:2px solid #e5e7eb;border-radius:10px;padding:10px 14px;font-size:.75rem;font-weight:600;color:#374151;text-align:center; }
    .causal-node.root { border-color:#ef4444;background:#fef2f2;color:#991b1b; }
    .causal-node.down { border-color:#f59e0b;background:#fffbeb;color:#92400e; }
    .cluster-header { padding:12px 16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;background:#f9fafb; }
    .cluster-header svg { transition:transform .2s; }
  </style>
</head>
<body class="bg-gray-50">
  <% const currentPage = 'data-aggregator'; %>
  <%- include('../partials/admin-mobile-header') %>
  <%- include('../partials/community-sidebar') %>

  <div class="lg:ml-64 min-h-screen pt-14 lg:pt-0">

    <!-- Top Bar -->
    <header class="bg-white border-b border-gray-200 sticky top-14 lg:top-0 z-10">
      <div class="px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">Data Aggregator</h2>
            <p class="text-sm text-gray-500 mt-0.5">Problem Intelligence Pipeline</p>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 px-3 py-1.5 bg-green-50 border border-green-200 rounded-full">
              <div class="status-dot"></div>
              <span class="text-xs font-medium text-green-700">Pipeline Ready</span>
            </div>
            <button onclick="simulateRun()" id="btn-run"
              class="flex items-center gap-2 px-4 py-2 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Run Pipeline
            </button>
          </div>
        </div>
      </div>
    </header>

    <main class="p-4 sm:p-6 lg:p-8 space-y-6">

      <!-- MOCK NOTICE -->
      <div class="flex items-center gap-3 px-4 py-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-800 text-xs">
        <svg class="w-4 h-4 flex-shrink-0 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
        <span><strong>Demo data</strong> — All numbers, problems, and insights shown on this page are mocked. The pipeline backend is not yet connected.</span>
      </div>

      <!-- STATS (6 cards) -->
      <div class="grid grid-cols-2 lg:grid-cols-6 gap-4">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Collected</p>
          <p class="text-3xl font-bold text-primary">247</p>
          <p class="text-xs text-green-600 mt-1">↑ +38 last run</p>
        </div>
        <div class="bg-white rounded-xl border border-red-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-red-500 uppercase tracking-wide mb-1">No Solution</p>
          <p class="text-3xl font-bold text-red-600">183</p>
          <p class="text-xs text-red-400 mt-1">74% of total</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Resolution Rate</p>
          <p class="text-3xl font-bold text-emerald-600">26%</p>
          <p class="text-xs text-emerald-600 mt-1">↑ +2% this month</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Deduped</p>
          <p class="text-3xl font-bold text-gray-800">91</p>
          <p class="text-xs text-gray-400 mt-1">36.7% dedup rate</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Avg Score</p>
          <p class="text-3xl font-bold text-gray-800">0.68</p>
          <p class="text-xs text-green-600 mt-1">↑ +0.04 vs prev</p>
        </div>
        <div class="bg-white rounded-xl border border-amber-100 shadow-sm p-5">
          <p class="text-xs font-semibold text-amber-600 uppercase tracking-wide mb-1">Pending Review</p>
          <p class="text-3xl font-bold text-amber-500">8</p>
          <p class="text-xs text-amber-500 mt-1">Awaiting admin</p>
        </div>
      </div>

      <!-- AI DIGEST + EMERGING ALERT -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 bg-gradient-to-br from-blue-50 to-sky-50 border border-blue-200 rounded-xl p-5">
          <div class="flex items-center gap-2 mb-3">
            <p class="text-xs font-bold text-blue-800 uppercase tracking-wide">AI Weekly Digest</p>
            <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-medium ml-auto">Groq · Llama 3</span>
          </div>
          <p class="text-sm text-blue-900 leading-relaxed">
            This week the pipeline collected <strong>247 problems</strong> across 4 sources. Dominant themes were <strong>antimicrobial resistance in Sub-Saharan Africa</strong> and <strong>freshwater scarcity in South Asia</strong>, both appearing simultaneously in arXiv, RSS, and World Bank — a strong signal of cross-disciplinary urgency. <strong>183 problems (74%) have no proposed solution</strong> in PSF, with Healthcare and Environment showing the largest gaps. A causal chain was detected: water scarcity → sanitation failure → child mortality spikes across 6 countries, suggesting one infrastructure solution could cascade into 3 separate problem resolutions.
          </p>
          <p class="text-xs text-blue-400 mt-3">Generated May 19, 2026 · 09:41 UTC</p>
        </div>

        <div class="bg-white rounded-xl border-2 border-red-200 p-5">
          <div class="flex items-center gap-2 mb-3">
            <div class="alert-dot"></div>
            <p class="text-xs font-bold text-red-700 uppercase tracking-wide">Emerging Alert</p>
          </div>
          <p class="text-sm font-semibold text-gray-900 leading-snug mb-2">Collapse of freshwater access in Pakistan's Indus River basin</p>
          <p class="text-xs text-gray-500 mb-3">Detected in <strong>6 independent sources</strong> in the last 48 hours.</p>
          <div class="flex flex-wrap gap-1.5 mb-4">
            <span class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-medium">Environment</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-red-50 text-red-600 font-medium">High</span>
            <span class="multi-source-badge">6 sources</span>
          </div>
          <a href="/admin/community-dashboard/problems" class="block w-full text-center bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg py-2 transition-colors">
            Act Now →
          </a>
        </div>
      </div>

      <!-- GAP ANALYSIS -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h3 class="text-sm font-bold text-gray-900">Gap Analysis — Problems vs. Solutions</h3>
            <p class="text-xs text-gray-500 mt-0.5">The space between bars is where volunteers are needed most</p>
          </div>
          <div class="flex items-center gap-4 text-xs text-gray-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-primary inline-block"></span>Problems</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span>Solutions</span>
          </div>
        </div>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-xs text-gray-600 mb-1.5"><span class="font-medium">Healthcare</span><span class="text-gray-400">62 problems · 8 solutions</span></div>
            <div class="space-y-1.5">
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-primary" style="width:0%" data-w="100%"></div></div>
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-emerald-500" style="width:0%" data-w="13%"></div></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs text-gray-600 mb-1.5"><span class="font-medium">Environment</span><span class="text-gray-400">48 problems · 11 solutions</span></div>
            <div class="space-y-1.5">
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-primary" style="width:0%" data-w="77%"></div></div>
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-emerald-500" style="width:0%" data-w="18%"></div></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs text-gray-600 mb-1.5"><span class="font-medium">Education</span><span class="text-gray-400">38 problems · 19 solutions</span></div>
            <div class="space-y-1.5">
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-primary" style="width:0%" data-w="61%"></div></div>
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-emerald-500" style="width:0%" data-w="31%"></div></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs text-gray-600 mb-1.5"><span class="font-medium">Economics</span><span class="text-gray-400">31 problems · 6 solutions</span></div>
            <div class="space-y-1.5">
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-primary" style="width:0%" data-w="50%"></div></div>
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-emerald-500" style="width:0%" data-w="10%"></div></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs text-gray-600 mb-1.5"><span class="font-medium">Technology</span><span class="text-gray-400">29 problems · 22 solutions</span></div>
            <div class="space-y-1.5">
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-primary" style="width:0%" data-w="47%"></div></div>
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-emerald-500" style="width:0%" data-w="35%"></div></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs text-gray-600 mb-1.5"><span class="font-medium">Social Issues</span><span class="text-gray-400">24 problems · 14 solutions</span></div>
            <div class="space-y-1.5">
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-primary" style="width:0%" data-w="39%"></div></div>
              <div class="bg-gray-100 rounded-full overflow-hidden" style="height:8px"><div class="bar-fill bg-emerald-500" style="width:0%" data-w="23%"></div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- CAUSAL CHAIN + CLUSTERS -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

        <!-- Causal Chain -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-sm font-bold text-gray-900">Causal Chain Detected</h3>
            <span class="text-xs bg-violet-100 text-violet-700 px-2 py-0.5 rounded-full font-medium">AI Insight</span>
          </div>
          <p class="text-xs text-gray-500 mb-4">Solving the root cause resolves downstream problems automatically.</p>
          <div class="flex flex-col items-center gap-2">
            <div class="causal-node root w-full">Water scarcity — Indus River basin<span class="block text-red-400 font-normal text-xs mt-0.5">Root cause</span></div>
            <div class="text-gray-400 text-lg leading-none">↓</div>
            <div class="causal-node down w-full">Sanitation infrastructure collapse<span class="block text-amber-500 font-normal text-xs mt-0.5">Direct effect</span></div>
            <div class="text-gray-400 text-lg leading-none">↓</div>
            <div class="grid grid-cols-2 gap-2 w-full">
              <div class="causal-node down text-xs">Waterborne disease outbreaks</div>
              <div class="causal-node down text-xs">Child school absenteeism</div>
            </div>
            <div class="text-gray-400 text-lg leading-none">↓</div>
            <div class="causal-node down w-full">Child mortality across 6 countries<span class="block text-amber-500 font-normal text-xs mt-0.5">3 downstream effects resolved if root solved</span></div>
          </div>
        </div>

        <!-- Semantic Clusters -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div class="flex items-center gap-2 mb-1">
            <h3 class="text-sm font-bold text-gray-900">Semantic Clusters</h3>
            <span class="text-xs bg-violet-100 text-violet-700 px-2 py-0.5 rounded-full font-medium">AI Grouped</span>
          </div>
          <p class="text-xs text-gray-500 mb-4">Problems grouped by meaning, not just keyword.</p>
          <div class="space-y-2 border border-gray-200 rounded-xl overflow-hidden">

            <div>
              <div class="cluster-header" onclick="toggleCluster(this)">
                <div class="flex items-center gap-2">
                  <div>
                    <p class="text-xs font-semibold text-gray-800">Antimicrobial Resistance</p>
                    <p class="text-xs text-gray-400">8 problems · 0 solutions</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded-full font-medium">High gap</span>
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </div>
              <div class="hidden px-4 pb-3 border-t border-gray-100">
                <p class="text-xs text-gray-500 py-2">Drug-resistant infections, antibiotic overuse, treatment resistance — from arXiv, RSS, and World Bank.</p>
                <a href="/admin/community-dashboard/problems" class="text-xs font-semibold text-primary hover:underline">Propose a solution for this cluster →</a>
              </div>
            </div>

            <div class="border-t border-gray-100">
              <div class="cluster-header" onclick="toggleCluster(this)">
                <div class="flex items-center gap-2">
                  <div>
                    <p class="text-xs font-semibold text-gray-800">Freshwater Access</p>
                    <p class="text-xs text-gray-400">11 problems · 2 solutions</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full font-medium">Medium gap</span>
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </div>
              <div class="hidden px-4 pb-3 border-t border-gray-100">
                <p class="text-xs text-gray-500 py-2">Contamination, scarcity, and infrastructure — 6 countries, 4 sources.</p>
                <a href="/admin/community-dashboard/problems" class="text-xs font-semibold text-primary hover:underline">Propose a solution for this cluster →</a>
              </div>
            </div>

            <div class="border-t border-gray-100">
              <div class="cluster-header" onclick="toggleCluster(this)">
                <div class="flex items-center gap-2">
                  <div>
                    <p class="text-xs font-semibold text-gray-800">Digital Exclusion</p>
                    <p class="text-xs text-gray-400">6 problems · 4 solutions</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">Low gap</span>
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
              </div>
              <div class="hidden px-4 pb-3 border-t border-gray-100">
                <p class="text-xs text-gray-500 py-2">Rural connectivity, digital literacy, device access — mostly World Bank data.</p>
                <a href="/admin/community-dashboard/problems" class="text-xs font-semibold text-primary hover:underline">View solutions →</a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- ACT NOW -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-gray-900">Act Now — Unaddressed Problems</h3>
            <p class="text-xs text-gray-500 mt-0.5">High-impact, no volunteer working on them yet</p>
          </div>
          <span class="text-xs bg-red-100 text-red-700 px-3 py-1 rounded-full font-semibold">183 unaddressed</span>
        </div>
        <div class="space-y-3">
          <div class="flex items-center gap-4 p-3 bg-red-50 border border-red-100 rounded-lg">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-gray-900 truncate">Antimicrobial resistance in Sub-Saharan Africa</p>
              <div class="flex flex-wrap items-center gap-2 mt-1">
                <span class="text-xs text-gray-500">Score: <strong class="font-mono text-red-600">0.84</strong></span>
                <span class="text-xs text-gray-300">·</span>
                <span class="text-xs text-gray-500">Healthcare · High · arXiv</span>
                <span class="text-xs font-semibold text-red-600">· 0 solutions</span>
              </div>
            </div>
            <a href="/admin/community-dashboard/problems" class="flex-shrink-0 text-xs font-bold text-white bg-primary hover:bg-blue-700 px-3 py-1.5 rounded-lg transition-colors">Propose →</a>
          </div>
          <div class="flex items-center gap-4 p-3 bg-red-50 border border-red-100 rounded-lg">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-gray-900 truncate">Maternal mortality crisis in conflict-affected regions</p>
              <div class="flex flex-wrap items-center gap-2 mt-1">
                <span class="text-xs text-gray-500">Score: <strong class="font-mono text-red-600">0.82</strong></span>
                <span class="text-xs text-gray-300">·</span>
                <span class="text-xs text-gray-500">Healthcare · High · World Bank</span>
                <span class="text-xs font-semibold text-red-600">· 0 solutions</span>
              </div>
            </div>
            <a href="/admin/community-dashboard/problems" class="flex-shrink-0 text-xs font-bold text-white bg-primary hover:bg-blue-700 px-3 py-1.5 rounded-lg transition-colors">Propose →</a>
          </div>
          <div class="flex items-center gap-4 p-3 bg-amber-50 border border-amber-100 rounded-lg">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-gray-900 truncate">Informal worker exclusion from social protection systems</p>
              <div class="flex flex-wrap items-center gap-2 mt-1">
                <span class="text-xs text-gray-500">Score: <strong class="font-mono text-amber-600">0.76</strong></span>
                <span class="text-xs text-gray-300">·</span>
                <span class="text-xs text-gray-500">Economics · High · Reddit</span>
                <span class="text-xs font-semibold text-red-600">· 0 solutions</span>
              </div>
            </div>
            <a href="/admin/community-dashboard/problems" class="flex-shrink-0 text-xs font-bold text-white bg-primary hover:bg-blue-700 px-3 py-1.5 rounded-lg transition-colors">Propose →</a>
          </div>
        </div>
      </div>

      <!-- PIPELINE (funnel) -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-5">Pipeline — Last Run</h3>
        <div class="grid grid-cols-5 gap-2" id="pipeline-funnel">

          <div class="flex flex-col items-center gap-2 stage-funnel" id="stage-0">
            <div class="w-full rounded-xl border-2 border-primary bg-blue-50 flex flex-col items-center justify-center py-5 px-2 transition-all">
              <span class="text-2xl font-bold text-primary font-mono" id="p-n0">138</span>
              <span class="text-xs text-primary font-semibold mt-0.5">signals</span>
            </div>
            <span class="text-xs font-semibold text-gray-700 text-center">Collected</span>
            <span class="text-xs text-gray-400 text-center leading-tight">Raw input from all sources</span>
          </div>

          <div class="flex items-start justify-center pt-6 text-gray-300 text-xl font-light">→</div>

          <div class="flex flex-col items-center gap-2 stage-funnel" id="stage-1">
            <div class="w-full rounded-xl border-2 border-gray-200 bg-gray-50 flex flex-col items-center justify-center py-5 px-2 transition-all">
