<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">

  <!-- Favicon - Multiple formats for browser compatibility -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon.png">

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#117dd4",
            "background-light": "#f6f7f8",
            "background-dark": "#101a22",
            "text-light": "#101a22",
            "text-dark": "#f6f7f8",
            "surface-light": "#ffffff",
            "surface-dark": "#1b2733",
            "border-light": "#e7eef3",
            "border-dark": "#2a3b4c",
            "muted-light": "#4c779a",
            "muted-dark": "#a0b3c4"
          },
          fontFamily: { "display": ["Inter", "sans-serif"] },
          borderRadius: { "DEFAULT": "0.5rem", "lg": "0.75rem", "xl": "1rem", "full": "9999px" }
        }
      }
    }
  </script>
  <link crossorigin="" href="https://fonts.gstatic.com/" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
</head>
<body class="font-display bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark">
  <div class="relative flex h-auto min-h-screen w-full flex-col">
    <div class="layout-container flex h-full grow flex-col">
      <%- include('../partials/header', { currentPage: currentPage }) %>
      <main class="flex-1">
        <section class="w-full">
          <div class="container mx-auto px-4 py-16 sm:py-24 lg:py-32">
            <div class="relative rounded-xl overflow-hidden min-h-[500px] flex items-end p-8" style='background-image: linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0.1)), url("https://lh3.googleusercontent.com/aida-public/AB6AXuAs0suKgBCVe3OY0hz6ORtAL-ruIf9JXVD5tsZ0nGfnGOpgArtl-k9uch0fCaGD73F5ctCJ-11mebjwB6MS5f4Yw-SM6DMFvMoq5ZeSGHuNamSAXnwcg74HU5wXlWaRyyxVixe-yHijyWeWPLGsXby6UlsejeGtoD9WzcOqfGMCD6eT9I9rhbXriYH0B25DdIIIV6-KrZ10xO-YTxSKFzPM9BOzFiCr9As9E_U7LPnTyR-sSmHV9o4mmdg7o6yaawjsT5aHiw8vuG0t"); background-size: cover; background-position: center;'>
              <div class="max-w-3xl text-white">
                <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-4">Solving the World's Toughest Challenges</h1>
                <p class="text-lg md:text-xl mb-8 opacity-90">The Problem Solver Foundation is dedicated to addressing the most pressing global issues through innovative solutions and collaborative efforts.</p>
                <button onclick="location.href='/about'" class="bg-primary text-white rounded-lg h-12 px-6 text-base font-bold hover:bg-opacity-90 transition-all">
                  <span class="truncate">Learn More</span>
                </button>
              </div>
            </div>
          </div>
        </section>
        <section class="bg-surface-light dark:bg-surface-dark py-16 sm:py-24">
          <div class="container mx-auto px-4">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Our Impact</h2>
              <p class="mt-4 text-lg text-muted-light dark:text-muted-dark max-w-2xl mx-auto">We measure our success by the lives we change and the communities we empower.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
              <div class="bg-background-light dark:bg-background-dark rounded-xl p-8 text-center shadow-sm">
                <p class="text-5xl font-black text-primary"><%= stats.totalProjectsFormatted %>+</p>
                <p class="mt-2 text-lg font-medium">Total Projects</p>
              </div>
              <div class="bg-background-light dark:bg-background-dark rounded-xl p-8 text-center shadow-sm">
                <p class="text-5xl font-black text-primary"><%= stats.totalLivesFormatted %>+</p>
                <p class="mt-2 text-lg font-medium">Lives Improved</p>
              </div>
              <div class="bg-background-light dark:bg-background-dark rounded-xl p-8 text-center shadow-sm">
                <p class="text-5xl font-black text-primary"><%= stats.totalVolunteersFormatted %>+</p>
                <p class="mt-2 text-lg font-medium">Team Members</p>
              </div>
            </div>
          </div>
        </section>

        <!-- PSF Community Audience Benefits Section -->
        <section class="py-16 sm:py-24">
          <div class="container mx-auto px-4">
            <div class="text-center mb-16">
              <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Join the PSF Community</h2>
              <p class="mt-4 text-lg text-muted-light dark:text-muted-dark max-w-2xl mx-auto">Discover the unique benefits designed for each member of our ecosystem</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
              <!-- 1. Ambassadors & Mentors -->
              <div class="bg-white/90 dark:bg-white/5 backdrop-blur-sm rounded-2xl p-8 shadow-[0_4px_12px_rgba(0,0,0,0.08)] dark:shadow-[0_4px_12px_rgba(0,0,0,0.3)] border border-white/20 dark:border-white/10 hover:shadow-[0_8px_24px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_8px_24px_rgba(0,0,0,0.4)] transition-all duration-300 flex flex-col">
                <div class="text-center mb-6">
                  <div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 dark:bg-primary/20 rounded-full mb-4">
                    <span class="material-symbols-outlined text-primary text-3xl">psychology</span>
                  </div>
                  <h3 class="text-xl font-bold text-primary">Ambassadors & Mentors</h3>
                  <p class="text-sm text-muted-light dark:text-muted-dark mt-2">Leadership & Expertise</p>
                </div>

                <div class="space-y-3 mb-8 flex-grow">
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">trending_up</span>
                    <span class="text-sm leading-relaxed">Market and scientific intelligence access</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">group</span>
                    <span class="text-sm leading-relaxed">Networking among entrepreneurs and specialists</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">lightbulb</span>
                    <span class="text-sm leading-relaxed">Support for product validation and creation</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">person_search</span>
                    <span class="text-sm leading-relaxed">Access to HR talent bank</span>
                  </div>
                </div>

                <button onclick="location.href='/contact'" class="w-full bg-primary text-white rounded-xl h-12 px-6 text-sm font-semibold hover:bg-primary/90 hover:shadow-lg transition-all duration-200">
                  <span class="truncate">Become an Ambassador</span>
                </button>
              </div>

              <!-- 2. Members -->
              <div class="bg-white/90 dark:bg-white/5 backdrop-blur-sm rounded-2xl p-8 shadow-[0_4px_12px_rgba(0,0,0,0.08)] dark:shadow-[0_4px_12px_rgba(0,0,0,0.3)] border border-white/20 dark:border-white/10 hover:shadow-[0_8px_24px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_8px_24px_rgba(0,0,0,0.4)] transition-all duration-300 flex flex-col">
                <div class="text-center mb-6">
                  <div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 dark:bg-primary/20 rounded-full mb-4">
                    <span class="material-symbols-outlined text-primary text-3xl">diversity_3</span>
                  </div>
                  <h3 class="text-xl font-bold text-primary">Members</h3>
                  <p class="text-sm text-muted-light dark:text-muted-dark mt-2">Growth & Community</p>
                </div>

                <div class="space-y-3 mb-8 flex-grow">
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">school</span>
                    <span class="text-sm leading-relaxed">Courses and training programs</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">forum</span>
                    <span class="text-sm leading-relaxed">Advisory meetings and mentorship</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">location_on</span>
                    <span class="text-sm leading-relaxed">Access to local PSF community</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">handshake</span>
                    <span class="text-sm leading-relaxed">Networking opportunities</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">book</span>
                    <span class="text-sm leading-relaxed">Educational materials and resources</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">local_offer</span>
                    <span class="text-sm leading-relaxed">Partner company service discounts</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">star</span>
                    <span class="text-sm leading-relaxed">Leadership guidance and development</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">recommend</span>
                    <span class="text-sm leading-relaxed">Talent bank with recommendation letters</span>
                  </div>
                </div>

                <button onclick="location.href='/signup'" class="w-full bg-primary text-white rounded-xl h-12 px-6 text-sm font-semibold hover:bg-primary/90 hover:shadow-lg transition-all duration-200">
                  <span class="truncate">Become a Member</span>
                </button>
              </div>

              <!-- 3. Partner Investors -->
              <div class="bg-white/90 dark:bg-white/5 backdrop-blur-sm rounded-2xl p-8 shadow-[0_4px_12px_rgba(0,0,0,0.08)] dark:shadow-[0_4px_12px_rgba(0,0,0,0.3)] border border-white/20 dark:border-white/10 hover:shadow-[0_8px_24px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_8px_24px_rgba(0,0,0,0.4)] transition-all duration-300 flex flex-col">
                <div class="text-center mb-6">
                  <div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 dark:bg-primary/20 rounded-full mb-4">
                    <span class="material-symbols-outlined text-primary text-3xl">business_center</span>
                  </div>
                  <h3 class="text-xl font-bold text-primary">Partner Investors</h3>
                  <p class="text-sm text-muted-light dark:text-muted-dark mt-2">Strategic Partnerships</p>
                </div>

                <div class="space-y-3 mb-8 flex-grow">
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">campaign</span>
                    <span class="text-sm leading-relaxed">Brand exposure and marketing opportunities</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">local_offer</span>
                    <span class="text-sm leading-relaxed">Exclusive discounts and partnership benefits</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">hub</span>
                    <span class="text-sm leading-relaxed">Access to innovation ecosystem</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">handshake</span>
                    <span class="text-sm leading-relaxed">Strategic partnership opportunities</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">schedule</span>
                    <span class="text-sm leading-relaxed">Early access to emerging solutions</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-sm mt-1">account_balance</span>
                    <span class="text-sm leading-relaxed">Networking with investors and entrepreneurs</span>
                  </div>
                </div>

                <button onclick="location.href='/contact'" class="w-full bg-primary text-white rounded-xl h-12 px-6 text-sm font-semibold hover:bg-primary/90 hover:shadow-lg transition-all duration-200">
                  <span class="truncate">Become a Partner</span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- COMMUNITY SIGNUP -->
        <section id="join-community" class="py-16 sm:py-24 bg-primary">
          <div class="container mx-auto px-4 max-w-2xl">
            <div class="text-center mb-10">
              <p class="text-sm font-semibold uppercase tracking-widest text-white/70 mb-3">Join the movement</p>
              <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white mb-4">Be part of the solution</h2>
              <p class="text-white/80 text-lg">Connect with problem-solvers around the world. Enter your details and we'll add you to our community.</p>
            </div>

            <% if (locals.communitySuccess) { %>
              <div class="bg-white/10 border border-white/30 rounded-xl p-6 text-center text-white">
                <p class="font-bold text-lg mb-1">You're in!</p>
                <p class="text-white/80 text-sm">Redirecting you to our Telegram community...</p>
              </div>
            <% } else { %>
              <% if (locals.communityError) { %>
                <div class="mb-4 bg-red-500/20 border border-red-300/30 rounded-lg px-4 py-3 text-white text-sm text-center">
                  <%= locals.communityError %>
                </div>
              <% } %>
              <form action="/community/join" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-white/80 mb-1">Full name</label>
                    <input type="text" name="name" required placeholder="Your name"
                      class="w-full rounded-lg px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/50 text-sm"/>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-white/80 mb-1">Email</label>
                    <input type="email" name="email" required placeholder="your@email.com"
                      class="w-full rounded-lg px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/50 text-sm"/>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-white/80 mb-1">Where are you from?</label>
                    <input type="text" name="location" required placeholder="City, Country"
                      class="w-full rounded-lg px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/50 text-sm"/>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-white/80 mb-1">Phone number</label>
                    <input type="tel" name="phone" required placeholder="+1 555 000 0000"
                      class="w-full rounded-lg px-4 py-3 bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/50 text-sm"/>
                  </div>
                </div>
                <button type="submit"
                  class="w-full bg-white text-primary font-bold rounded-lg py-3 text-sm hover:bg-white/90 transition-colors mt-2">
                  Join the Community
                </button>
                <p class="text-xs text-white/50 text-center">You'll be redirected to our Telegram group after submitting.</p>
              </form>
            <% } %>
          </div>
        </section>

        <section class="py-16 sm:py-24">
          <div class="container mx-auto px-4">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Latest from Our Blog</h2>
              <p class="mt-4 text-lg text-muted-light dark:text-muted-dark max-w-2xl mx-auto">Insights, stories, and updates from the people working to solve the world's toughest challenges.</p>
            </div>
            <% if (voicesPosts && voicesPosts.length > 0) { %>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% voicesPosts.forEach(post => { %>
                  <div class="bg-surface-light dark:bg-surface-dark rounded-xl overflow-hidden flex flex-col shadow-sm hover:shadow-lg transition-shadow cursor-pointer" onclick="location.href='/blog/<%= post.slug %>'">
                    <% if (post.imageUrl) { %>
                      <img alt="<%= post.title %>" class="w-full h-48 object-cover" src="<%= post.imageUrl %>" onerror="this.src='https://via.placeholder.com/400x300?text=Voices+from+Our+Community'"/>
                    <% } else { %>
                      <div class="w-full h-48 bg-primary/10 flex items-center justify-center">
                        <span class="text-primary text-4xl">💬</span>
                      </div>
                    <% } %>
                    <div class="p-6 flex-1 flex flex-col">
                      <h3 class="text-lg font-bold mb-2"><%= post.title %></h3>
                      <% if (post.excerpt) { %>
                        <p class="text-muted-light dark:text-muted-dark text-sm leading-relaxed line-clamp-3"><%= post.excerpt %></p>
                      <% } %>
                      <% if (post.author) { %>
                        <p class="mt-auto pt-4 text-xs text-muted-light dark:text-muted-dark font-medium">— <%= post.author %></p>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="text-center py-12">
                <p class="text-muted-light dark:text-muted-dark">No community voices available yet. Check back soon!</p>
              </div>
            <% } %>
          </div>
        </section>
      </main>
      <%- include('../partials/footer') %>
    </div>
  </div>
  <%- include('../partials/scripts', { pageScripts: [], inlineScript: null }) %>
</body>
</html>
