                  <div class="space-y-4 text-sm">
                    <div class="flex gap-3">
                      <div class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary"></div>
                      <div>
                        <p class="font-semibold">2017</p>
                        <p class="text-black/60 dark:text-white/60">Personal awakening and beginning of the journey</p>
                      </div>
