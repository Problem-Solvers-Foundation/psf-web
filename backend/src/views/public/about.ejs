                    <div class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Years to 2035</div>
                  </div>

                  <div class="space-y-6">
                    <!-- Goal Progress -->
                    <div>
                      <div class="flex justify-between items-center mb-2">
                        <span class="text-sm font-medium">Problem Solvers</span>
                        <span class="text-sm text-primary font-bold" id="current-members">3</span>
                      </div>
                      <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                        <div class="bg-gradient-to-r from-primary to-blue-600 h-2 rounded-full transition-all duration-1000" style="width: 0.0001%" id="progress-bar"></div>
