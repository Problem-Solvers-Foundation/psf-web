  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
</head>
<body class="font-display bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark">
  <div class="relative flex h-auto min-h-screen w-full flex-col">
    <div class="layout-container flex h-full grow flex-col">
      <%- include('../partials/header', { currentPage: currentPage }) %>
      <main class="flex-1">
        <div class="container mx-auto px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-24">
          <div class="grid grid-cols-1 gap-8 sm:gap-12 xl:grid-cols-5 xl:gap-16">
            <div class="xl:col-span-3">
              <!-- Hero Section -->
              <div class="mb-12 sm:mb-16">
                <div class="text-center mb-6 sm:mb-8">
                  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl mb-4 sm:mb-6 leading-tight">
                    Building a Network of
                    <span class="text-primary block sm:inline">1 Billion Problem Solvers</span>
                  </h1>
                  <p class="text-base sm:text-lg lg:text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-3xl mx-auto px-2 sm:px-0">
                    By 2035, we're uniting a global community to tackle humanity's most pressing challenges through collaborative action and innovative solutions.
                  </p>
                </div>

                <!-- Hero Stats -->
                <div class="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6 mt-8 sm:mt-12">
                  <div class="text-center p-4 sm:p-0">
                    <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text-light dark:text-text-dark mb-1 sm:mb-2">1B</div>
                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Problem Solvers by 2035</p>
                  </div>
                  <div class="text-center p-4 sm:p-0">
                    <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text-light dark:text-text-dark mb-1 sm:mb-2">500T</div>
                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Potential Connections</p>
                  </div>
                  <div class="text-center p-4 sm:p-0 xs:col-span-2 sm:col-span-1">
                    <div class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text-light dark:text-text-dark mb-1 sm:mb-2">12%</div>
                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Of Global Population</p>
                  </div>
                </div>
              </div>

              <!-- Our Story Section -->
              <div class="space-y-8 sm:space-y-12">
                <div>
                  <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold mb-4 sm:mb-6 lg:mb-8">Our Story</h2>
                  <p class="text-sm sm:text-base lg:text-lg text-gray-600 dark:text-gray-300 mb-6 sm:mb-8 lg:mb-10 leading-relaxed">
                    From a personal moment of crisis to a vision for global change—this is how the Problem Solvers Foundation came to life.
                  </p>

                  <!-- Timeline -->
                  <div class="relative">
                    <!-- Timeline Line -->
                    <div class="absolute left-6 sm:left-8 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700"></div>

                    <!-- Timeline Items -->
                    <div class="space-y-8 sm:space-y-12">
                      <!-- 2017: The Turning Point -->
                      <div class="relative flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 sm:w-16 sm:h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold z-10 text-xs sm:text-sm">
                          2017
                        </div>
                        <div class="ml-4 sm:ml-6 flex-grow">
                          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-primary">The Turning Point</h3>
                            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
                              A routine doctor's appointment revealed Haniel Rolemberg's father had skin cancer—a moment that shifted everything. As a teenager who had witnessed family members lose battles with cancer, Haniel made an ambitious promise: he would cure cancer for the world.
                            </p>
                          </div>
                        </div>
                      </div>

                      <!-- 2018-2020: The Awakening -->
                      <div class="relative flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 sm:w-16 sm:h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold z-10 text-xs sm:text-sm">
                          2018
                        </div>
                        <div class="ml-4 sm:ml-6 flex-grow">
                          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-primary dark:text-primary">The Awakening</h3>
                            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
                              Realizing that noble dreams need preparation, Haniel Rolemberg left his job as a salesman to dedicate himself to studying and building solutions. He chose to prepare for the future, knowing that one day he would be ready to make the difference he had always dreamed of.
                            </p>
                          </div>
                        </div>
                      </div>

                      <!-- 2021-2022: The Discovery -->
                      <div class="relative flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 sm:w-16 sm:h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold z-10 text-xs sm:text-sm">
                          2021
                        </div>
                        <div class="ml-4 sm:ml-6 flex-grow">
                          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-primary dark:text-primary">The Discovery</h3>
                            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
                              After years of working in isolation, Haniel Rolemberg discovered a fundamental truth: real change only happens when people come together. The teenage dream of single-handedly curing cancer evolved into understanding that great transformations emerge when groups unite around a common goal.
                            </p>
                          </div>
                        </div>
                      </div>

                      <!-- 2023: The Training Ground -->
                      <div class="relative flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 sm:w-16 sm:h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold z-10 text-xs sm:text-sm">
                          2023
                        </div>
                        <div class="ml-4 sm:ml-6 flex-grow">
                          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-primary dark:text-primary">The Training Ground</h3>
                            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
                              Haniel Rolemberg joined organizations like Google Developer Group, PMI, and Rotaract. Through these experiences, he gained confidence, developed communication skills, and learned to lead. More importantly, he found people who, like him, wanted to use their skills for something real.
                            </p>
                          </div>
                        </div>
                      </div>

                      <!-- 2024: The Foundation -->
                      <div class="relative flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 sm:w-16 sm:h-16 bg-primary rounded-full flex items-center justify-center text-white font-bold z-10 text-xs sm:text-sm">
                          2025
                        </div>
                        <div class="ml-4 sm:ml-6 flex-grow">
                          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 sm:p-6">
                            <h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-primary dark:text-primary">The Foundation</h3>
                            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
                              These experiences gave him the strength to create the Problem Solvers Foundation—a community built on the belief that we are all problem solvers; we just need to be connected, organized, and empowered to act. The teenage dream had evolved into something greater.
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Our Mission Section -->
                <div>
                  <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold mb-4 sm:mb-6">Our Mission</h2>
                  <div class="space-y-3 sm:space-y-4 text-black/60 dark:text-white/60 leading-relaxed">
                    <p class="text-base sm:text-lg lg:text-xl font-semibold text-black/80 dark:text-white/80">
                      By 2035, unite 1 billion people in coordinated action to become protagonists in solving the problems that define humanity's future.
                    </p>
                    <p class="text-sm sm:text-base">
                      This isn't just a number—it's strategic. One billion people represents approximately 12% of the global population by 2035. Having 12% of people actively engaged as problem solvers in every country creates a critical mass capable of driving systemic change.
                    </p>
                    <p class="text-sm sm:text-base">
                      Our mission is built on a simple truth: numbers alone don't create impact—connections do. When we connect 1 billion problem solvers, we're not just adding individual contributors—we're creating something unprecedented. Using the network connection formula n×(n-1)/2, one billion connected people generate approximately 500 billion potential connections.
                    </p>
                    <p class="text-sm sm:text-base">
                      We're creating platforms for collaboration, systems for rapid solution deployment, and communities that turn individual passion into collective impact. We're connecting the farmer worried about drought with the engineer developing water-efficient irrigation. We're linking the teacher in an underserved community with the programmer building educational AI. We're bringing together the young activist and the experienced executive to scale solutions that work.
                    </p>
                  </div>
                </div>

                <!-- Critical Challenges Section -->
                <div>
                  <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold mb-6 sm:mb-8">The Challenges We're Addressing</h2>
                  <p class="text-sm sm:text-base lg:text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-8 sm:mb-12">
                    By 2035, the problems we face today will either be on their way to resolution, or they will have spiraled into catastrophic consequences. We're focusing our efforts on the most critical global challenges:
                  </p>

                  <!-- Simplified Challenge List -->
                  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Biodiversity</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Energy Sources</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Health</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Education</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Economic Stability</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Demographics</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Cybersecurity</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Individual Freedoms</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">Space Exploration</h4>
                    </div>
                    <div class="text-center p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-primary hover:shadow-md transition-all duration-200">
                      <h4 class="font-semibold text-sm">AI Impact</h4>
                    </div>
                  </div>
                </div>

                <!-- Our Approach Section -->
                <div>
                  <h2 class="text-3xl font-bold mb-8">Our Approach: The Power of Network Effects</h2>
                  <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-8">
                    Through years of experience working both in isolation and within communities, we learned that working alone—no matter how dedicated—has limits. But when people connect around shared purpose, something exponential happens.
                  </p>

                  <!-- Network Effects Visualization -->
                  <div class="bg-gray-50 dark:bg-gray-800 rounded-2xl p-8 mb-8">
                    <h3 class="text-xl font-bold text-center mb-6">The Power of Network Effects</h3>
                    <p class="text-center text-gray-600 dark:text-gray-400 mb-8">
                      When problem solvers connect, the impact grows exponentially
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-6">
                      <div class="text-center p-4 bg-white dark:bg-gray-700 rounded-lg">
                        <div class="text-xl font-bold text-text-light dark:text-text-dark mb-1">1 Billion</div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Problem Solvers by 2035</p>
                      </div>
                      <div class="text-center p-4 bg-white dark:bg-gray-700 rounded-lg">
                        <div class="text-xl font-bold text-text-light dark:text-text-dark mb-1">500 Trillion</div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Potential Connections</p>
                      </div>
                      <div class="text-center p-4 bg-white dark:bg-gray-700 rounded-lg">
                        <div class="text-xl font-bold text-text-light dark:text-text-dark mb-1">500K×</div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Multiplier Effect</p>
                      </div>
                    </div>

                    <div class="text-center space-y-2">
                      <p class="text-xs text-gray-500 dark:text-gray-500 italic">
                        Every new problem solver added creates exponential connection opportunities
                      </p>
                      <div class="bg-gray-100 dark:bg-gray-700 rounded-lg p-3 inline-block">
                        <p class="text-xs text-gray-600 dark:text-gray-400 font-mono">
                          Formula: <span class="font-semibold text-primary">n×(n-1)/2</span>
                        </p>
                        <p class="text-xs text-gray-500 dark:text-gray-500">
                          where <em>n</em> = number of problem solvers
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- Connection Examples -->
                  <div class="space-y-8 mb-16">
                    <!-- Global Connection Examples -->
                    <div>
                      <h4 class="text-lg font-semibold mb-6 text-text-light dark:text-text-dark">How Global Connections Work</h4>
                      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                          <h5 class="font-semibold mb-2">Knowledge Transfer</h5>
                          <p class="text-sm text-gray-600 dark:text-gray-400">A farmer in Kenya learns from agricultural innovators in Israel</p>
                        </div>
                        <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                          <h5 class="font-semibold mb-2">Resource Sharing</h5>
                          <p class="text-sm text-gray-600 dark:text-gray-400">Silicon Valley entrepreneurs fund solutions developed in Nigeria</p>
                        </div>
                        <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                          <h5 class="font-semibold mb-2">Skill Matching</h5>
                          <p class="text-sm text-gray-600 dark:text-gray-400">Climate scientists collaborate with indigenous knowledge keepers</p>
                        </div>
                      </div>
                    </div>

                    <!-- Network Advantages -->
                    <div>
                      <h4 class="text-lg font-semibold mb-6 text-text-light dark:text-text-dark">Why Networks Create Impact</h4>
                      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                          <h5 class="font-semibold mb-2">Rapid Response</h5>
                          <p class="text-sm text-gray-600 dark:text-gray-400">Instant mobilization of experts and resources during crises</p>
                        </div>
                        <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                          <h5 class="font-semibold mb-2">Innovation Acceleration</h5>
                          <p class="text-sm text-gray-600 dark:text-gray-400">Faster problem-solving when the right minds connect</p>
                        </div>
                        <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                          <h5 class="font-semibold mb-2">Exponential Growth</h5>
                          <p class="text-sm text-gray-600 dark:text-gray-400">Each new member multiplies collective intelligence</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Call to Action -->
                <div class="mt-32 pt-16">
                  <h2 class="text-3xl font-bold text-center mb-6">Ready to Be Part of the Solution?</h2>
                  <p class="text-lg text-gray-600 dark:text-gray-300 text-center mb-12 leading-relaxed max-w-3xl mx-auto">
                    The future isn't something that happens to us—it's something we build together. Whether you're a student with big ideas, a professional with specialized skills, or someone who simply refuses to accept that things can't get better—there's a place for you in this movement.
                  </p>

                  <!-- Helper entry point -->
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-10 px-6 py-5 bg-primary/5 border border-primary/20 rounded-xl">
                    <div>
                      <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-1">Start here</p>
                      <p class="font-semibold text-gray-900 dark:text-white">New to PSF? Join as a helper first.</p>
                      <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">The fastest way in — share your name, email, and location and we'll welcome you into the community immediately.</p>
                    </div>
                    <a href="/#join-community" class="shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-opacity-90 transition-all whitespace-nowrap">
                      Join as a helper
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  </div>

                  <p class="text-center text-sm text-gray-500 dark:text-gray-400 mb-8">Already a helper? Level up and choose your path below.</p>

                  <!-- Multiple Entry Points -->
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Ambassadors & Mentors -->
                    <div class="text-center p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:shadow-lg transition-all duration-200 group flex flex-col">
                      <h3 class="text-xl font-semibold mb-3">Ambassadors & Mentors</h3>
                      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6 flex-grow">
                        Share your expertise and guide the next generation of problem solvers through leadership and mentorship.
                      </p>
                      <a href="/contact" class="w-full inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-opacity-90 transition-all group-hover:scale-105">
                        Become an Ambassador
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </a>
                    </div>

                    <!-- Members -->
                    <div class="text-center p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:shadow-lg transition-all duration-200 group flex flex-col">
                      <h3 class="text-xl font-semibold mb-3">Members</h3>
                      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6 flex-grow">
                        Join our community of problem solvers and contribute your unique skills to global challenges.
                      </p>
                      <a href="/signup" class="w-full inline-flex items-center justify-center px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-opacity-90 transition-all group-hover:scale-105">
                        Become a Member
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </a>
                    </div>

                    <!-- Partner Investors -->
                    <div class="text-center p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl hover:shadow-lg transition-all duration-200 group flex flex-col">
                      <h3 class="text-xl font-semibold mb-3">Partner Investors</h3>
                      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6 flex-grow">
                        Organizations and institutions ready to amplify impact through strategic collaboration and investment.
                      </p>
                      <a href="/contact" class="w-full inline-flex items-center justify-center px-6 py-3 bg-purple-600 text-white font-medium rounded-lg hover:bg-opacity-90 transition-all group-hover:scale-105">
                        Become a Partner
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sidebar -->
            <div class="xl:col-span-2 mt-8 xl:mt-0">
              <div class="xl:sticky xl:top-28 space-y-6 sm:space-y-8">
                <!-- Founder Section -->
                <div class="text-center p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl">
                  <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="text-2xl font-bold text-white">HR</span>
                  </div>
                  <h3 class="text-lg font-semibold mb-1">Haniel Rolemberg</h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400">Founder of PSF</p>
                </div>

                <!-- Dynamic Stats Card -->
                <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 sm:p-6">
                  <h3 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6 text-center">Our Mission Progress</h3>

                  <!-- Countdown to 2035 -->
                  <div class="text-center mb-4 sm:mb-6 p-3 sm:p-4 bg-gradient-to-r from-primary/10 to-purple-500/10 rounded-lg">
