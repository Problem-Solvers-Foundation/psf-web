<div class="bg-background-light dark:bg-background-dark min-h-screen">

  <!-- Header -->
  <div class="border-b border-border-light dark:border-border-dark">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-14 pb-10">
      <p class="text-xs font-bold uppercase tracking-widest text-primary mb-3" style="font-family:'Inter',sans-serif;">Problem Solver Foundation</p>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-text-light dark:text-text-dark mb-3" style="font-family:'Inter',sans-serif;">
        Blog
      </h1>
      <p class="text-lg text-muted-light dark:text-muted-dark max-w-2xl" style="font-family:'Inter',sans-serif;">
        Insights, stories, and updates from the people working to solve the world's toughest challenges.
      </p>

      <!-- Category tabs -->
      <% if (categories && categories.length > 0) { %>
        <div class="mt-8 flex flex-wrap gap-2">
          <a href="/blog"
            class="px-4 py-1.5 rounded-full text-sm font-semibold transition-colors <%= !currentCategory ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700' %>"
            style="font-family:'Inter',sans-serif;">
            All <% if (!currentCategory) { %>(<%= posts.length %>)<% } %>
          </a>
          <% categories.forEach(cat => { %>
            <a href="/blog?category=<%= encodeURIComponent(cat) %>"
              class="px-4 py-1.5 rounded-full text-sm font-semibold transition-colors <%= currentCategory === cat ? 'bg-primary text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700' %>"
              style="font-family:'Inter',sans-serif;">
              <%= cat %> <% if (currentCategory === cat) { %>(<%= posts.length %>)<% } %>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (currentTag) { %>
        <div class="mt-4 flex items-center gap-2">
          <span class="text-sm text-muted-light dark:text-muted-dark" style="font-family:'Inter',sans-serif;">Filtered by tag:</span>
          <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-semibold" style="font-family:'Inter',sans-serif;">#<%= currentTag %></span>
          <a href="/blog" class="text-xs text-muted-light dark:text-muted-dark hover:text-primary underline" style="font-family:'Inter',sans-serif;">Clear</a>
        </div>
      <% } %>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">

    <% if (posts && posts.length > 0) { %>

      <% const featured = posts[0]; const rest = posts.slice(1); %>

      <!-- Featured post (primeiro) -->
      <a href="/blog/<%= featured.slug %>" class="group block mb-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 rounded-2xl overflow-hidden border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark hover:shadow-xl transition-shadow duration-300">
          <% if (featured.imageUrl) { %>
            <div class="overflow-hidden lg:order-2">
              <img src="<%= featured.imageUrl %>" alt="<%= featured.title %>"
                class="w-full h-64 lg:h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.parentElement.style.display='none'"/>
            </div>
          <% } %>
          <div class="p-8 lg:p-10 flex flex-col justify-center <%= featured.imageUrl ? '' : 'lg:col-span-2' %>">
            <div class="flex items-center gap-3 mb-4">
              <% if (featured.category) { %>
                <span class="px-3 py-1 bg-primary text-white text-xs font-bold uppercase tracking-widest rounded-full" style="font-family:'Inter',sans-serif;"><%= featured.category %></span>
              <% } %>
              <span class="text-xs text-muted-light dark:text-muted-dark font-medium" style="font-family:'Inter',sans-serif;">Latest post</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-text-light dark:text-text-dark group-hover:text-primary transition-colors leading-tight mb-4" style="font-family:'Inter',sans-serif;">
              <%= featured.title %>
            </h2>
            <% if (featured.excerpt) { %>
              <p class="text-muted-light dark:text-muted-dark leading-relaxed mb-6 line-clamp-3" style="font-family:'Inter',sans-serif;"><%= featured.excerpt %></p>
            <% } %>
            <div class="flex items-center gap-4 mt-auto">
              <% if (featured.author) { %>
                <div class="flex items-center gap-2">
                  <div class="h-8 w-8 rounded-full bg-primary/15 flex items-center justify-center shrink-0">
                    <span class="text-primary font-bold text-xs" style="font-family:'Inter',sans-serif;"><%= featured.author.charAt(0).toUpperCase() %></span>
                  </div>
                  <span class="text-sm font-medium text-text-light dark:text-text-dark" style="font-family:'Inter',sans-serif;"><%= featured.author %></span>
                </div>
                <span class="text-muted-light dark:text-muted-dark">·</span>
              <% } %>
              <% if (featured.createdAt) { %>
                <time class="text-sm text-muted-light dark:text-muted-dark" style="font-family:'Inter',sans-serif;">
                  <%= new Date(featured.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </time>
              <% } %>
              <% if (featured.readingTime) { %>
                <span class="text-muted-light dark:text-muted-dark">·</span>
                <span class="text-sm text-muted-light dark:text-muted-dark" style="font-family:'Inter',sans-serif;"><%= featured.readingTime %> min read</span>
              <% } %>
            </div>
          </div>
        </div>
      </a>

      <!-- Remaining posts grid -->
      <% if (rest.length > 0) { %>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% rest.forEach(post => { %>
            <a href="/blog/<%= post.slug %>" class="group block rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark overflow-hidden hover:shadow-lg transition-shadow duration-200">

              <% if (post.imageUrl) { %>
                <div class="overflow-hidden">
                  <img src="<%= post.imageUrl %>" alt="<%= post.title %>"
                    class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300"
                    onerror="this.parentElement.style.display='none'"/>
                </div>
              <% } else { %>
                <div class="w-full h-44 bg-primary/5 dark:bg-primary/10 flex items-center justify-center">
                  <svg width="32" height="32" viewBox="0 0 48 48" fill="none" class="text-primary opacity-25">
                    <path clip-rule="evenodd" d="M12.0799 24L4 19.2479L9.95537 8.75216L18.04 13.4961L18.0446 4H29.9554L29.96 13.4961L38.0446 8.75216L44 19.2479L35.92 24L44 28.7521L38.0446 39.2479L29.96 34.5039L29.9554 44H18.0446L18.04 34.5039L9.95537 39.2479L4 28.7521L12.0799 24Z" fill="currentColor" fill-rule="evenodd"/>
                  </svg>
                </div>
              <% } %>

              <div class="p-5">
                <% if (post.category) { %>
                  <span class="text-xs font-bold uppercase tracking-widest text-primary" style="font-family:'Inter',sans-serif;"><%= post.category %></span>
                <% } %>
                <h2 class="mt-2 text-base font-bold text-text-light dark:text-text-dark group-hover:text-primary transition-colors leading-snug line-clamp-2" style="font-family:'Inter',sans-serif;">
                  <%= post.title %>
                </h2>
                <% if (post.excerpt) { %>
                  <p class="mt-2 text-sm text-muted-light dark:text-muted-dark line-clamp-2 leading-relaxed" style="font-family:'Inter',sans-serif;"><%= post.excerpt %></p>
                <% } %>
                <div class="mt-4 flex items-center gap-2 text-xs text-muted-light dark:text-muted-dark" style="font-family:'Inter',sans-serif;">
                  <% if (post.author) { %>
                    <span class="font-medium text-text-light dark:text-text-dark"><%= post.author %></span>
                    <span>·</span>
                  <% } %>
                  <% if (post.createdAt) { %>
                    <time><%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></time>
                  <% } %>
                  <% if (post.readingTime) { %>
                    <span>·</span>
                    <span><%= post.readingTime %> min</span>
                  <% } %>
                </div>
              </div>

            </a>
          <% }); %>
        </div>
      <% } %>

    <% } else { %>
      <div class="text-center py-24">
        <svg class="mx-auto h-12 w-12 text-gray-300 dark:text-gray-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-lg font-semibold text-gray-400 dark:text-gray-600" style="font-family:'Inter',sans-serif;">No posts found</p>
        <% if (currentCategory || currentTag) { %>
          <a href="/blog" class="mt-3 inline-block text-sm text-primary hover:underline" style="font-family:'Inter',sans-serif;">Clear filters</a>
        <% } %>
      </div>
    <% } %>

  </div>
</div>
