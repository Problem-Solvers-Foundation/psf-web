<!-- Sticky reading header -->
<div id="sticky-header" style="position:fixed;top:0;left:0;right:0;z-index:9998;transform:translateY(-100%);transition:transform 0.2s ease;background:white;border-bottom:1px solid #e7eef3;">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 h-12 flex items-center gap-4">
    <svg width="18" height="18" viewBox="0 0 48 48" fill="none" class="shrink-0" style="color:#117dd4;">
      <path clip-rule="evenodd" d="M12.0799 24L4 19.2479L9.95537 8.75216L18.04 13.4961L18.0446 4H29.9554L29.96 13.4961L38.0446 8.75216L44 19.2479L35.92 24L44 28.7521L38.0446 39.2479L29.96 34.5039L29.9554 44H18.0446L18.04 34.5039L9.95537 39.2479L4 28.7521L12.0799 24Z" fill="currentColor" fill-rule="evenodd"/>
    </svg>
    <span id="sticky-title" class="text-sm font-semibold text-gray-800 truncate flex-1" style="font-family:'Inter',sans-serif;"><%= post.title %></span>
    <span id="sticky-progress-text" class="text-xs text-gray-400 shrink-0" style="font-family:'Inter',sans-serif;">0%</span>
  </div>
  <div id="sticky-progress-bar" style="height:2px;background:#117dd4;width:0%;transition:width 0.08s linear;"></div>
</div>

<style>
  .dark #sticky-header {
    background: #1b2733;
    border-bottom-color: #2a3b4c;
  }
  .dark #sticky-title { color: #f0f6fc; }
  .dark #sticky-progress-text { color: #4c779a; }
</style>


<article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">

  <!-- Hero image -->
  <% if (post.imageUrl) { %>
    <div class="mb-6 overflow-hidden rounded-2xl shadow-lg relative">
      <img
        src="<%= post.imageUrl %>"
        alt="<%= post.title %>"
        class="w-full h-[460px] object-cover object-center"
        onerror="this.parentElement.style.display='none'"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent pointer-events-none rounded-2xl"></div>
    </div>
  <% } %>

  <!-- Header -->
  <header class="mb-6">

    <% if (post.category) { %>
      <a href="/blog?category=<%= post.category %>" class="inline-block rounded-full bg-primary/10 text-primary px-4 py-1.5 text-xs font-bold uppercase tracking-widest mb-5 hover:bg-primary/20 transition-colors">
        <%= post.category %>
      </a>
    <% } %>

    <h1 class="text-3xl font-extrabold text-text-light dark:text-text-dark sm:text-4xl lg:text-5xl mb-6 leading-tight tracking-tight" style="font-family:'Inter',sans-serif;">
      <%= post.title %>
    </h1>

    <div class="flex flex-wrap items-center gap-5 pb-7 border-b border-border-light dark:border-border-dark">

      <% if (post.author) { %>
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-primary/15 flex items-center justify-center ring-2 ring-primary/20 shrink-0">
            <span class="text-primary font-bold text-base" style="font-family:'Inter',sans-serif;">
              <%= post.author.charAt(0).toUpperCase() %>
            </span>
          </div>
          <div class="flex flex-col">
            <span class="text-xs text-muted-light dark:text-muted-dark uppercase tracking-wider font-medium" style="font-family:'Inter',sans-serif;">Author</span>
            <span class="font-semibold text-text-light dark:text-text-dark text-sm" style="font-family:'Inter',sans-serif;">
              <%= post.author %>
            </span>
          </div>
        </div>
      <% } %>

      <div class="h-6 w-px bg-border-light dark:bg-border-dark"></div>

      <div class="flex flex-col">
        <span class="text-xs text-muted-light dark:text-muted-dark uppercase tracking-wider font-medium" style="font-family:'Inter',sans-serif;">Published</span>
        <div class="flex items-center gap-2 text-text-light dark:text-text-dark text-sm" style="font-family:'Inter',sans-serif;">
          <time datetime="<%= post.createdAt %>">
            <%
              const date = new Date(post.createdAt);
              const formattedDate = date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              });
            %>
            <%= formattedDate %>
          </time>
          <% if (post.readingTime) { %>
            <span class="text-muted-light dark:text-muted-dark">·</span>
            <span class="text-muted-light dark:text-muted-dark"><%= post.readingTime %> min read</span>
          <% } %>
        </div>
      </div>

    </div>
  </header>

  <!-- Excerpt -->
  <% if (post.excerpt) { %>
    <div class="mb-6 p-5 bg-primary/5 dark:bg-primary/10 rounded-xl" style="border-left: 3px solid #117dd4;">
      <p class="text-lg text-text-light dark:text-text-dark leading-relaxed italic" style="font-family:'Lora',Georgia,serif;">
        <%= post.excerpt %>
      </p>
    </div>
  <% } %>

  <!-- Content -->
  <div class="prose max-w-none">
    <%- post.content %>
  </div>

  <!-- CTA de conversão -->
  <div class="mt-8 rounded-2xl bg-primary px-8 py-7 flex flex-col sm:flex-row items-center justify-between gap-5">
    <div>
      <p class="text-white font-bold text-lg leading-snug" style="font-family:'Inter',sans-serif;">Ready to be part of the solution?</p>
      <p class="text-white/75 text-sm mt-1" style="font-family:'Inter',sans-serif;">Join the PSF community and help solve the world's toughest challenges.</p>
    </div>
    <a href="/#join-community" class="shrink-0 bg-white text-primary font-bold text-sm px-6 py-3 rounded-xl hover:bg-white/90 transition-colors whitespace-nowrap" style="font-family:'Inter',sans-serif;">
      Join the movement
    </a>
  </div>

  <!-- Post end separator -->
  <div class="mt-8 mb-6 flex items-center justify-center gap-4">
    <div class="flex-1 h-px bg-border-light dark:bg-border-dark"></div>
    <svg width="24" height="24" viewBox="0 0 48 48" fill="none" class="text-primary opacity-40 shrink-0">
      <path clip-rule="evenodd" d="M12.0799 24L4 19.2479L9.95537 8.75216L18.04 13.4961L18.0446 4H29.9554L29.96 13.4961L38.0446 8.75216L44 19.2479L35.92 24L44 28.7521L38.0446 39.2479L29.96 34.5039L29.9554 44H18.0446L18.04 34.5039L9.95537 39.2479L4 28.7521L12.0799 24Z" fill="currentColor" fill-rule="evenodd"/>
    </svg>
    <div class="flex-1 h-px bg-border-light dark:bg-border-dark"></div>
  </div>

  <!-- Author card -->
  <% if (post.author) { %>
    <div class="mb-6 flex items-center gap-4">
      <div class="h-12 w-12 rounded-full bg-primary/15 flex items-center justify-center ring-2 ring-primary/20 shrink-0">
        <span class="text-primary font-bold text-lg" style="font-family:'Inter',sans-serif;"><%= post.author.charAt(0).toUpperCase() %></span>
      </div>
      <div>
        <p class="text-xs text-muted-light dark:text-muted-dark uppercase tracking-wider font-medium mb-0.5" style="font-family:'Inter',sans-serif;">Written by</p>
        <p class="font-semibold text-text-light dark:text-text-dark" style="font-family:'Inter',sans-serif;"><%= post.author %></p>
      </div>
    </div>
  <% } %>

  <!-- Tags -->
  <% if (post.tags && post.tags.length > 0) { %>
    <div class="mb-6">
      <div class="flex flex-wrap gap-2">
        <% post.tags.forEach(tag => { %>
          <a
            href="/blog?tag=<%= tag %>"
            class="inline-block px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 rounded-full text-xs font-medium hover:bg-primary/10 hover:text-primary dark:hover:bg-primary/20 dark:hover:text-primary transition-colors"
            style="font-family:'Inter',sans-serif;"
          >#<%= tag %></a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Actions bar -->
  <div class="flex items-center justify-between pt-5 border-t border-border-light dark:border-border-dark">

    <a href="/blog" class="inline-flex items-center gap-2 text-primary hover:underline text-sm font-medium" style="font-family:'Inter',sans-serif;">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Blog
    </a>

    <div class="flex items-center gap-3">
      <span class="text-xs text-gray-500 dark:text-gray-400 font-medium" style="font-family:'Inter',sans-serif;">Share</span>
      <button
        onclick="window.open('https://twitter.com/intent/tweet?url='+encodeURIComponent(window.location.href)+'&text='+encodeURIComponent('<%= post.title.replace(/'/g, "\\'") %>'),'_blank','noopener')"
        class="text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors"
        title="Share on Twitter"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.71v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/>
        </svg>
      </button>
      <button
        onclick="window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(window.location.href),'_blank','noopener')"
        class="text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors"
        title="Share on Facebook"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </button>
      <button
        onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.title='Copied!';setTimeout(()=>this.title='Copy link',2000)})"
        class="text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors"
        title="Copy link"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
      </button>
    </div>

  </div>

</article>

<!-- Related posts -->
<% if (relatedPosts && relatedPosts.length > 0) { %>
  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="border-t border-border-light dark:border-border-dark pt-10">
      <h2 class="text-xl font-bold text-text-light dark:text-text-dark mb-6" style="font-family:'Inter',sans-serif;">Continue reading</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <% relatedPosts.forEach(related => { %>
          <a href="/blog/<%= related.slug %>" class="group block bg-surface-light dark:bg-surface-dark rounded-xl overflow-hidden hover:shadow-md transition-shadow border border-border-light dark:border-border-dark">
            <% if (related.imageUrl) { %>
              <div class="overflow-hidden">
                <img src="<%= related.imageUrl %>" alt="<%= related.title %>" class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.parentElement.style.display='none'"/>
              </div>
            <% } else { %>
              <div class="w-full h-36 bg-primary/8 flex items-center justify-center">
                <svg width="28" height="28" viewBox="0 0 48 48" fill="none" class="text-primary opacity-30">
                  <path clip-rule="evenodd" d="M12.0799 24L4 19.2479L9.95537 8.75216L18.04 13.4961L18.0446 4H29.9554L29.96 13.4961L38.0446 8.75216L44 19.2479L35.92 24L44 28.7521L38.0446 39.2479L29.96 34.5039L29.9554 44H18.0446L18.04 34.5039L9.95537 39.2479L4 28.7521L12.0799 24Z" fill="currentColor" fill-rule="evenodd"/>
                </svg>
              </div>
            <% } %>
            <div class="p-4">
              <% if (related.category) { %>
                <span class="text-xs font-semibold text-primary uppercase tracking-wide" style="font-family:'Inter',sans-serif;"><%= related.category %></span>
              <% } %>
              <p class="mt-1 text-sm font-semibold text-text-light dark:text-text-dark leading-snug group-hover:text-primary transition-colors line-clamp-2" style="font-family:'Inter',sans-serif;"><%= related.title %></p>
              <% if (related.readingTime) { %>
                <p class="mt-2 text-xs text-muted-light dark:text-muted-dark" style="font-family:'Inter',sans-serif;"><%= related.readingTime %> min read</p>
              <% } %>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<!-- Back to top button -->
<button
  id="back-to-top"
  onclick="window.scrollTo({top:0,behavior:'smooth'})"
  style="position:fixed;bottom:2rem;right:2rem;display:none;z-index:50;"
  class="h-11 w-11 rounded-full bg-primary text-white shadow-lg flex items-center justify-center hover:bg-primary/90 transition-all hover:scale-105"
  title="Back to top"
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
  </svg>
</button>

<script>
  const backToTop = document.getElementById('back-to-top');
  const stickyHeader = document.getElementById('sticky-header');
  const stickyProgressBar = document.getElementById('sticky-progress-bar');
  const stickyProgressText = document.getElementById('sticky-progress-text');
  const articleHeader = document.querySelector('article header');

  window.addEventListener('scroll', () => {
    const total = document.body.scrollHeight - window.innerHeight;
    const pct = total > 0 ? Math.round(window.scrollY / total * 100) : 0;

    stickyProgressBar.style.width = pct + '%';
    stickyProgressText.textContent = pct + '%';

    backToTop.style.display = window.scrollY > 400 ? 'flex' : 'none';

    const threshold = articleHeader ? articleHeader.getBoundingClientRect().bottom + window.scrollY : 300;
    stickyHeader.style.transform = window.scrollY > threshold ? 'translateY(0)' : 'translateY(-100%)';
  });
</script>
